# Telegram
BOT_TOKEN=123456:ABC-your-telegram-bot-token
ADMIN_CHAT_ID=-7745303007
ADMIN_USER_IDS=7745303007

# Database — local dev only: a plain SQLite file, used when DATABASE_URL
# (below) is empty. Do NOT rely on this in production on Render's free
# tier — its disk is wiped on every deploy, taking every user/order/price
# edit with it.
DATABASE_PATH=./diamond_bot.db

# Production database — a real Postgres connection string (e.g. from a
# free Supabase project) that survives deploys. Setting this overrides
# DATABASE_PATH entirely. Format: postgresql+asyncpg://user:password@host:port/dbname
# Get this from Supabase: Project Settings -> Database -> Connection
# string -> URI (use the "Session pooler" or direct connection, not the
# "Transaction pooler" — this bot is one long-running process, not
# serverless). Then change the scheme prefix from "postgresql://" to
# "postgresql+asyncpg://". Never commit the real value — Render env vars
# only.
DATABASE_URL=

# Deployment on Render (or any always-on host).
# REQUIRED on Render itself — set this in the Render dashboard's
# Environment tab to your service's real https URL (e.g.
# https://your-service-name.onrender.com), no trailing slash. Left empty
# here on purpose (rather than a guessed default) means: empty ->
# webhook mode never starts, bot falls back to polling instead. That's
# what you want for local development (PUBLIC_URL= as below avoids
# fighting over the same webhook as the live Render deployment) — but on
# Render, forgetting to set this means the bot silently never receives
# any Telegram updates at all, so double-check it's set there.
PUBLIC_URL=
TELEGRAM_WEBHOOK_PATH=/tg-webhook
# Any random hard-to-guess string; proves incoming requests really came
# from Telegram and not from someone else hitting your public URL.
TELEGRAM_WEBHOOK_SECRET=
# Render sets this automatically at runtime — leave as-is for local runs.
PORT=8080

# Payment provider: "manual" works out of the box (customer sends a receipt
# screenshot, admin confirms in the bot). Switch to "alif" or "dc" only
# after you have signed a real merchant agreement with that bank and
# received real Shop ID / Secret Key / API docs from them.
PAYMENT_PROVIDER=manual

# Your own card that receives customer payments — shown in the bot and (if
# set) used to build a pre-filled ExpressPay pay-by-link ("💳 Пардохт"
# button) so the customer doesn't type the card/amount by hand. Test the
# generated link for real before relying on it.
RECEIVING_CARD_NUMBER=
# http:// on purpose — the https cert doesn't match this hostname.
EXPRESSPAY_BASE_URL=http://pay.expresspay.tj/
# Required by the page; meaning unconfirmed, copied from a real working link.
EXPRESSPAY_F1=133

ALIF_SHOP_ID=
ALIF_SECRET_KEY=
ALIF_API_BASE_URL=
ALIF_CALLBACK_PATH=/webhooks/alif

# "💳 Алиф", "💳 Эсхата" and "💳 Амонатбонк" (all manual, all admin-
# confirmed) share this ONE phone number — the customer sends from their
# own Alif/Eskhata/Amonatbonk app, all three land in the same account.
# ("💳 ДС" is the separate one that uses a CARD number — see
# RECEIVING_CARD_NUMBER above.) If you already set ALIF_CARD_NUMBER or
# DC_TRANSFER_NUMBER before, those still work as fallbacks — no change
# needed on Render — but MOBILE_TRANSFER_NUMBER is now the one place to
# edit going forward. Optionally set matching photos per method with
# /setalifcardphoto, /seteskhatacardphoto, /setamonatbonkcardphoto.
MOBILE_TRANSFER_NUMBER=976820008

# Dushanbe City Bank (dc.tj) merchant/acquiring — contact them directly as
# a registered business to get these.
DC_SHOP_ID=
DC_SECRET_KEY=
DC_API_BASE_URL=
DC_CALLBACK_PATH=/webhooks/dc

WEBHOOK_SERVER_HOST=0.0.0.0
WEBHOOK_SERVER_PORT=8080

# Force-Join gate (bot/middlewares.py): the bot won't respond to anything
# else until the user is a confirmed member of this channel. Must be in
# "@handle" form — that's what bot.get_chat_member() expects. The bot
# account itself must be an admin of the channel (or the channel must be
# public) for the membership check to work at all.
CHANNEL_USERNAME=
# Public t.me link shown on the "📢 Join Channel" button. Optional — if
# left blank, it's derived automatically from CHANNEL_USERNAME above.
CHANNEL_URL=
# Leave CHANNEL_USERNAME empty to disable the Force-Join gate entirely
# (e.g. while testing locally).

# SMS auto payment confirmation: an app on the admin's own phone forwards
# incoming DC Bank "Zachislenie" (deposit) SMS to this URL, and matching
# pending orders get confirmed automatically without a button tap.
# https://telegrambotff-jbqe.onrender.com/sms-webhook?secret=<SMS_WEBHOOK_SECRET>
# Leave the secret empty to disable this endpoint entirely.
SMS_WEBHOOK_PATH=/sms-webhook
SMS_WEBHOOK_SECRET=
SMS_MATCH_WINDOW_MINUTES=60

# Diamond delivery provider: "manual" works out of the box (admin tops up
# the player by hand via the official app/site, then taps "Delivered" in
# the bot). "fazercards" calls the real FazerCards reseller API once your
# products are mapped to real category/offer IDs — run /fzr_categories,
# /fzr_offers <category_id> and /mapproduct <product_id> <category_id>
# <offer_id> in the bot first. "auto" is a generic scaffold for any other
# supplier's API (see bot/services/delivery.py).
DELIVERY_PROVIDER=manual

# FazerCards (api.fzr.cards) reseller API key. Keep this out of git —
# it's real money. Only goes in Render's environment variables / your
# local .env, never committed.
FAZERCARDS_API_KEY=
FAZERCARDS_API_BASE_URL=https://api.fzr.cards

SUPPLIER_API_BASE_URL=
SUPPLIER_API_KEY=

